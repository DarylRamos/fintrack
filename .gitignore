# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# generated Prisma Client
/lib/db/generated/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# documents
*.docx

# database backups (the routine writes them outside the project; this is a second guard)
fintrack-backup-*

# Playwright session for the signed-in e2e tests (unit 1.2a)
/tests/e2e/.auth/

# Python bytecode from the ui-ux-pro-max skill's scripts
__pycache__/

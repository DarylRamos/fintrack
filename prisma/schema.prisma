// FinTrack database schema. Conventions (unit 1.5): PascalCase singular models, snake_case plural
// tables and snake_case columns through @@map/@map, Postgres-generated UUID keys, timestamptz(3)
// timestamps. See context/code-standards.md → Prisma.
// The connection URL lives in prisma.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../lib/db/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// One row per user, created on the first save (unit 1.5). The key is the Supabase auth user's ID,
// so it is also the owner column; there is no foreign key, because Prisma doesn't model `auth`.
model Profile {
  id                String   @id @db.Uuid
  displayName       String?  @map("display_name") @db.VarChar(50)
  preferredCurrency String   @map("preferred_currency") @db.Char(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("profiles")
}

// Income or expense (unit 2.2). Amounts are always above 0; the type gives the direction.
enum TransactionType {
  income
  expense

  @@map("transaction_type")
}

// One income or expense (unit 2.2). It keeps its original amount and currency (invariant 2); the date
// is a calendar date with no time of day. Categories, tags, notes and receipts arrive in units 2.3 and
// 2.5, each with its own migration. See context/feature-specs/2.2-transaction-create-edit-delete.md.
model Transaction {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  type        TransactionType
  amount      Decimal         @db.Decimal(19, 4)
  currency    String          @db.Char(3)
  occurredOn  DateTime        @map("occurred_on") @db.Date
  description String          @db.VarChar(100)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, occurredOn(sort: Desc), createdAt(sort: Desc)])
  @@map("transactions")
}

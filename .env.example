# Copy this file to .env.local and fill in the DEVELOPMENT Supabase project's values.
# Never put production values in a file in this folder. They live in Vercel and a password manager.
# Both strings use the dedicated `prisma` role (user `prisma.<project-ref>`), not `postgres`.
# See context/feature-specs/0.3-supabase-projects-prisma-setup.md.

# App runtime: Supabase Transaction pooler, port 6543, with ?pgbouncer=true appended.
DATABASE_URL="postgresql://prisma.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"

# Prisma CLI and migrations: Supabase Session pooler, port 5432.
DIRECT_URL="postgresql://prisma.<project-ref>:<password>@<pooler-host>:5432/postgres"

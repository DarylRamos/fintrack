# Copy this file to .env.local and fill in the DEVELOPMENT Supabase project's values.
# Never put production values in a file in this folder. They live in Vercel and a password manager.
# Both strings use the dedicated `prisma` role (user `prisma.<project-ref>`), not `postgres`.
# See context/feature-specs/0.3-supabase-projects-prisma-setup.md.

# App runtime: Supabase Transaction pooler, port 6543, with ?pgbouncer=true appended.
DATABASE_URL="postgresql://prisma.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"

# Prisma CLI and migrations: Supabase Session pooler, port 5432.
DIRECT_URL="postgresql://prisma.<project-ref>:<password>@<pooler-host>:5432/postgres"

# Bearer token for scheduled routes (app/api/cron/). Not needed for `npm run dev`; only set it to call
# a scheduled route locally. Production's value lives only in Vercel and a password manager.
# See context/feature-specs/0.6-vercel-deployment-daily-cron.md.
CRON_SECRET="<random-64-character-hex-string>"

# Supabase Auth: Settings -> API Keys. Both are public by design (the publishable key is meant for
# browsers) and hold no secret. Never put the secret key (sb_secret_...) or the service_role key here.
# Use each project's own values: development here, production only in Vercel.
# See context/feature-specs/1.1a-email-sign-up-sign-in-password-reset.md.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<key>"
